# Static analysis for this package, aligned with `hypervel/components`' own
# phpstan.neon.dist on the 0.4 branch: the same level, the same two analysis settings and
# the same framework extensions. Matching them means a finding here is a finding there, and
# that a fix carried upstream lands clean.
#
# Components also sets parallelism and scans stub files, for a monorepo whose source uses
# BASE_PATH and Swoole's IDE helpers. src/ here uses neither, so neither is copied.
includes:
    # PHPStan support for Eloquent's forwarded builder and model methods, named scopes and
    # the framework's helper functions. The split hypervel/database and hypervel/foundation
    # packages register these through `extra.phpstan`, but development here installs the
    # hypervel/components monorepo, whose root composer.json carries no such entry. So they
    # are included by path, as components includes them itself.
    - vendor/hypervel/components/src/database/extension.neon
    - vendor/hypervel/components/src/foundation/extension.neon

parameters:
    level: 5
    inferPrivatePropertyTypeFromConstructor: true
    treatPhpDocTypesAsCertain: false

    # Result cache. PHPStan defaults it to the system temp dir, which a CI runner throws
    # away with the runner and a local `docker compose run --rm` with its container, so
    # every run would pay for a full analysis. It sits in tests/.cache/ instead, beside
    # PHPUnit's and php-cs-fixer's caches: gitignored, and kept in the checkout, so it
    # persists across local runs. PHPStan resolves the path against this file. It has to
    # be set here rather than on the command line: there is no --tmp-dir option (only the
    # unrelated editor-mode --tmp-file). The cache step in .github/workflows/tests.yml
    # caches the whole of tests/.cache/, so this path and that step have to agree.
    tmpDir: tests/.cache/phpstan

    # src/ only. tests/ and workbench/ are fixtures — the Workbench application exists to be
    # a deliberately shaped host app, not to be type-correct — and analysing them would
    # report on scaffolding rather than on shipped code.
    paths:
        - src

    # The first of two deliberate divergences from components, which turns this off because
    # its global patterns belong to many packages and a run over a subset of them would
    # report the rest as unmatched. Nothing here is shared that way, so an ignore whose
    # pattern stops matching fails the run instead of being left to rot.
    reportUnmatchedIgnoredErrors: true

    # The second: components leaves this off. Here an inline ignore names the error it
    # ignores and says why, as `@phpstan-ignore method.notFound (the reason)`, so the next
    # reader can tell whether it still has to be there. An ignore that covers everything on
    # its line (@phpstan-ignore-line, @phpstan-ignore-next-line) is reported outright.
    reportIgnoresWithoutComments: true
