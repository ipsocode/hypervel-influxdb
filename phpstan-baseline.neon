parameters:
	ignoreErrors:
		-
			message: '#^Argument of an invalid type list\<string\>\|false supplied for foreach, only iterables are supported\.$#'
			identifier: foreach.nonIterable
			count: 1
			path: src/InfluxQL/Builder.php

		-
			message: '#^Cannot access offset 1 on non\-empty\-list\<string\>\|false\.$#'
			identifier: offsetAccess.nonOffsetAccessible
			count: 1
			path: src/InfluxQL/Builder.php

		-
			message: '#^Method Ipsocode\\InfluxDB\\InfluxQL\\Builder\:\:getBindings\(\) should return list\<mixed\> but returns array\.$#'
			identifier: return.type
			count: 1
			path: src/InfluxQL/Builder.php

		-
			message: '#^Parameter \#2 \$bindings of method Ipsocode\\InfluxDB\\InfluxQL\\Builder\:\:send\(\) expects list\<mixed\>, array given\.$#'
